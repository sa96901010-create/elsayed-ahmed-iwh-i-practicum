doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Pets
    a(href="/update-cobj") Add to this table
    table.table
      thead
        tr
          th Name
          th Species
          th Age
          th Bio
      tbody
        each pet in data
          tr
            td= pet.properties.name
            td= pet.properties.species
            td= pet.properties.age
            td= pet.properties.bio
        if !data.length
          tr
            td(colspan="4") No pets yet.
